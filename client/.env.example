# Pinata IPFS Credentials (Optional - can also be configured directly in the app UI)
REACT_APP_PINATA_JWT=your_pinata_jwt_token_here
REACT_APP_PINATA_API_KEY=your_pinata_api_key_here
REACT_APP_PINATA_SECRET_KEY=your_pinata_secret_key_here

# Smart Contract Address (Optional - defaults to auto-deployed address in contractAddress.json)
REACT_APP_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
